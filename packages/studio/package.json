{
  "name": "dsh-preset-studio",
  "version": "2.1.0",
  "type": "module",
  "description": "A visual studio for DeepSeek Harness agent presets: edit preset files, toggle prompt injections, documents, skills and tool rows, and install presets — all in one panel. The same package ships the injector and the document write-back tool the panel wires up.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "preset",
    "prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HYcally/dsh-preset-studio.git",
    "directory": "packages/studio"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./inject": "./inject.js",
    "./docs": "./docs.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "frontmatter.js",
    "client.js",
    "inject.js",
    "docs.js",
    "cordis.patch.yml",
    "template/**",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
