{
  "name": "@local/dsh-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "预设工作室的面板：读写预设文件、装/卸预设。注入投递与文档写回是独立包。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "frontmatter.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
